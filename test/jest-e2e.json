{
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "setupFiles": ["<rootDir>/test/utils/entorno-pruebas.ts"],
  "moduleFileExtensions": ["js", "json", "ts"],
  "transform": {
    "/node_modules/(jose|@opentelemetry/otlp-exporter-base)/.+\\.js$": "<rootDir>/test/utils/transformar-jose.cjs",
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": "tsconfig.json",
        "diagnostics": false
      }
    ]
  },
  "transformIgnorePatterns": ["/node_modules/(?!(jose|@opentelemetry/otlp-exporter-base)/)"],
  "testTimeout": 20000,
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/generated/**",
    "!src/main.ts",
    "!src/**/*.module.ts",
    "!src/**/*.routes.ts"
  ],
  "coverageDirectory": "coverage",
  "coverageReporters": ["text-summary", "json-summary", "text"]
}
