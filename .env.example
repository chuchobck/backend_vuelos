DATABASE_URL="postgresql://postgres:postgres@localhost:5432/booking_db?schema=vuelos"
NODE_ENV=development
PORT=3000
# Puerto del host para el PostgreSQL de docker-compose. Si lo cambias, cambia también DATABASE_URL.
DB_PORT=5432
# Orígenes que pueden llamar a la API desde un navegador (CORS), separados por coma, sin ruta ni
# barra final y sin "*". Opcional: vacía o ausente, ningún origen de navegador puede llamar.
# Ejemplo: CORS_ORIGINS=https://quinde.example.com,http://localhost:5173
CORS_ORIGINS=
# Límite de peticiones por IP en toda la API: máximo por ventana y duración de la ventana en
# segundos. Opcionales; valen 100 y 60. Al pasarse, 429 con Retry-After.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60
# Proxies entre el cliente y la API, para que la IP del cliente (límite de peticiones, auditoría)
# sea la de X-Forwarded-For y no la del proxy. false = ninguno (local); 1 = un proxy, como Render.
# También acepta una lista de IP, CIDR, loopback, linklocal o uniquelocal. "true" no se acepta.
TRUST_PROXY=false
# Administrador de desarrollo que siembra ./db/reset.sh (no lo usa la API). Sin contraseña no
# se crea. La contraseña va solo en tu .env, nunca en git; de 12 a 128 caracteres.
SEED_ADMIN_EMAIL=admin@quinde.example
SEED_ADMIN_PASSWORD=
# Clave de firma (HS256) de los tokens de acceso. Obligatoria con AUTH_MODE=local (la de por
# defecto), de al menos 32 caracteres: sin ella la API no arranca. Con AUTH_MODE=external no se
# usa para los tokens; si se quita, BOARDING_PASS_SECRET pasa a ser obligatoria. Genera una
# propia, nunca la subas:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Clave de la firma de los códigos de barras de los pases de abordar. Opcional: sin ella se usa
# JWT_SECRET (de donde salía antes), así los pases ya emitidos siguen verificando. Si se define,
# debe tener al menos 32 caracteres; con un valor distinto del JWT_SECRET con que se emitieron,
# los pases ya emitidos dejan de verificar. Para dejar de depender de JWT_SECRET, cópiale su valor.
# BOARDING_PASS_SECRET=
# Clave con la que se cifra el secreto de cada webhook (AES-256-GCM). Obligatoria, de al menos 32
# caracteres: sin ella la API no arranca. Genera una propia, nunca la subas. Si la cambias, los
# secretos ya guardados quedan ilegibles y hay que volver a registrar los webhooks:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
WEBHOOK_SECRET_KEY=
# Quién emite los tokens de acceso (docs/DEPLOY.md, "Cambio de modo de autenticación"):
#   local     (por defecto) la API emite y verifica sus propios tokens HS256 con JWT_SECRET (/auth)
#   external  el servicio de identidad (identity_vuelos): la API verifica sus tokens RS256 con su
#             JWKS y no monta /auth ni /admin/users. Exige JWT_ISSUER y JWT_AUDIENCE.
AUTH_MODE=local
# Emisor (iss) y audiencia (aud) de los tokens. Con AUTH_MODE=local son opcionales y valen
# quinde-vuelos-api. Con AUTH_MODE=external son obligatorias: JWT_ISSUER es el JWT_ISSUER del
# servicio de identidad, un origen sin ruta ni barra final (https en producción), como
# http://localhost:3001; JWT_AUDIENCE, quinde-vuelos-api.
JWT_ISSUER=quinde-vuelos-api
JWT_AUDIENCE=quinde-vuelos-api
# Con AUTH_MODE=external, de dónde se bajan las claves públicas. Opcional; vale
# {JWT_ISSUER}/.well-known/jwks.json. https en producción.
# JWKS_URL=
# Quién reparte los webhooks (docs/MIGRACION-WEBHOOKS.md): local (por defecto) = el core, como
# siempre; notifier = el core publica cada evento al servicio notifier y no monta /webhooks. Con
# notifier son obligatorias las cuatro de abajo; con local no se leen.
WEBHOOKS_MODE=local
# NOTIFIER_URL=http://localhost:3002
# IDENTITY_TOKEN_URL=http://localhost:3001/oauth2/token
# El cliente core-vuelos de identity, creado con --scopes "events:publish" --permitir-eventos.
# NOTIFIER_CLIENT_ID=
# NOTIFIER_CLIENT_SECRET=
# Relevo de la bandeja de eventos al notifier (solo con notifier). Sin valor: true y cada 5 s.
# EVENT_RELAY_JOB_ENABLED=true
# EVENT_RELAY_JOB_INTERVAL_SECONDS=5
# Minutos que vale una oferta de POST /search antes de vencer (después el seatmap da 404 y el
# hold 409). Opcional; de 5 a 240, vale 30.
SEARCH_OFFER_TTL_MINUTES=30
# Minutos que un hold (POST /offers/hold) retiene el cupo; al vencer, el cupo vuelve.
# Opcional; de 1 a 60, vale 15.
HOLD_TTL_MINUTES=15
# Minutos que vale una cotización de cancelación; vencida, POST .../cancel responde 409.
# Opcional; de 1 a 60, vale 15.
CANCELLATION_QUOTE_TTL_MINUTES=15
# Minutos que vale una oferta de cambio de fecha; vencida, POST .../date-change responde 410.
# Opcional; de 1 a 60, vale 15.
CHANGE_OFFER_TTL_MINUTES=15
# Proceso que vence los holds abandonados (devuelve su cupo) y borra las claves de idempotencia
# vencidas, cada HOLD_EXPIRY_JOB_INTERVAL_SECONDS segundos. Opcionales; valen true y 60 (de 5 a
# 3600). Con false, un hold vencido se cierra recién al consultarlo o al competir por su cupo.
HOLD_EXPIRY_JOB_ENABLED=true
HOLD_EXPIRY_JOB_INTERVAL_SECONDS=60
# Proceso que emite los boletos de las reservas con pago pendiente (respuesta 202 de POST
# /bookings) cuando la Payment API lo aprueba, cada BOOKING_ISSUE_JOB_INTERVAL_SECONDS segundos.
# Opcionales; valen true y 30 (de 5 a 3600). Con false, esas reservas quedan en PENDING_PAYMENT.
BOOKING_ISSUE_JOB_ENABLED=true
BOOKING_ISSUE_JOB_INTERVAL_SECONDS=30
# Proceso que completa la postventa con pago o reembolso pendiente (maletas, cambios de fecha y
# cancelaciones en 202) y purga las ofertas de cambio y cotizaciones vencidas, cada
# POSTSALE_JOB_INTERVAL_SECONDS segundos. Opcionales; valen true y 30 (de 5 a 3600).
POSTSALE_JOB_ENABLED=true
POSTSALE_JOB_INTERVAL_SECONDS=30
# Proceso que envía los webhooks pendientes (POST firmado a la URL de cada suscripción) y reintenta
# los fallidos (1 min, 5 min, 30 min, 2 h; 5 intentos), cada WEBHOOK_DELIVERY_JOB_INTERVAL_SECONDS
# segundos. Opcionales; valen true y 10 (de 5 a 3600). Con false, los eventos se acumulan sin enviarse.
WEBHOOK_DELIVERY_JOB_ENABLED=true
WEBHOOK_DELIVERY_JOB_INTERVAL_SECONDS=10
# Ventana de check-in de cada vuelo: abre CHECKIN_OPENS_HOURS_BEFORE horas antes de la salida
# programada y cierra CHECKIN_CLOSES_MINUTES_BEFORE minutos antes. Opcionales; valen 48 (de 2 a
# 168) y 60 (de 15 a 90).
CHECKIN_OPENS_HOURS_BEFORE=48
CHECKIN_CLOSES_MINUTES_BEFORE=60
# Servidor gRPC interno (contracts/proto/flights/v1/flights.proto), además de REST, para el BFF:
# SearchFlights, GetSeatMap y GetFlightStatus, sin token. Opcionales; valen false y 50051. Con
# false el puerto no se abre. GRPC_PORT debe ser distinto de PORT. Ver docs/GRPC.md.
GRPC_ENABLED=false
GRPC_PORT=50051
# Observabilidad (docs/OBSERVABILIDAD.md del gateway): el SDK de trazas siempre arranca y propaga el
# traceparent; solo se exporta con OTEL_EXPORTER_OTLP_ENDPOINT (OTLP/HTTP, p. ej. Jaeger en 4318).
# Opcionales. OTEL_TRACES_SAMPLER_ARG vale 1.0 en desarrollo y 0.1 en producción; el core continúa
# el traceparent que recibe (TRACE_TRUST_INCOMING=true). /metrics sale por METRICS_PORT, aparte de
# PORT (0 lo apaga; 9466 es el puerto de los cinco servicios corriendo juntos en una máquina).
OTEL_SERVICE_NAME=quinde-core
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_TRACES_SAMPLER_ARG=1.0
TRACE_TRUST_INCOMING=true
METRICS_PORT=9466
